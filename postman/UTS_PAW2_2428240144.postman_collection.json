                      "function post(path, obj, cb) { pm.sendRequest({ url: base + path, method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify(obj) } }, cb); }",
                      "var r = Math.random().toString(36).slice(2,6).toUpperCase();",
                      "var fid = pm.collectionVariables.get('fakultasId') || '000000000000000000000000';",
                      "post('/fakultas', { kode: 'U' + r, nama: 'Fakultas Dipakai' }, function (e, res) {",
                      "  var f = res.json();",
                      "  pm.collectionVariables.set('usedFakultasId', f._id);",
                      "  post('/kandidat', { noUrut: 'U' + r, nama: 'Kandidat Terkait', jumlahPendukung: 1, jalur: 'independen', wakil: { nama: 'Wakil', nim: '1' }, fakultasId: f._id }, function () {});",
                      "});"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
